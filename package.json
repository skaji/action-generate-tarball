{
  "name": "action-generate-tarball",
  "version": "1.0.0",
  "private": true,
  "description": "Generate tar.gz archives for GitHub Actions",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "test": "vitest run",
    "pre-checkin": "npm run format && npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skaji/action-generate-tarball.git"
  },
  "keywords": [
    "actions",
    "tarball",
    "archive",
    "gzip"
  ],
  "author": "Shoichi Kaji",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "tar": "^7.5.15"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "esbuild": "^0.28.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
